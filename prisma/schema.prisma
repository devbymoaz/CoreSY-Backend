// Prisma schema for CoreSY backend
// Defines database models for authentication and user management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SubscriptionTier {
  FREE
  PREMIUM
  ENTERPRISE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum PermissionStatus {
  ACTIVE
  INACTIVE
}

enum BusinessStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  INACTIVE
  ACTIVE
}

enum BusinessType {
  RESTAURANT
  CAFE
  BAR
  MEDICAL_CLINIC
  HOSPITAL
  DENTAL_CLINIC
  PHARMACY
  BEAUTY_SALON
  SPA
  GYM
  SPORTS_CLUB
  ENTERTAINMENT_CENTER
  JUICE_SHOP
  SWEET_SHOP
  SUPERMARKET
  RETAIL_STORE
  OTHER
}

enum BranchStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
}

enum ServiceStatus {
  DRAFT
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum ServiceType {
  RESTAURANT
  CAFE
  BAR
  MEDICAL_CONSULTATION
  DENTAL_CONSULTATION
  LABORATORY
  PHARMACY
  BEAUTY_SERVICE
  SPA_TREATMENT
  GYM_MEMBERSHIP
  SPORTS_ACTIVITY
  ENTERTAINMENT_ACTIVITY
  DELIVERY_PRODUCT
  RETAIL_PRODUCT
  OTHER
}

enum ServiceCategory {
  FOOD_AND_DRINKS
  MEDICAL
  HEALTHCARE
  BEAUTY
  FITNESS
  SPORTS
  ENTERTAINMENT
  RETAIL
  DELIVERY
  OTHER
}

enum CashierStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  RESIGNED
  DELETED
}

enum SlotStatus {
  AVAILABLE
  FULL
  CLOSED
  CANCELLED
  INACTIVE
}

enum BookingType {
  RESERVATION
  APPOINTMENT
  WALK_IN
}

enum RecurringType {
  DAILY
  WEEKLY
  MONTHLY
  NONE
}

enum GenderRestriction {
  MALE
  FEMALE
  BOTH
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  REJECTED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CASH
  WALLET
}

enum BookingSource {
  MOBILE_APP
  WEB
  WALK_IN
  ADMIN
}

enum QRStatus {
  GENERATED
  ACTIVE
  SCANNED
  COMPLETED
  EXPIRED
  CANCELLED
  INVALID
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  HIDDEN
  DELETED
}

enum ProductUnit {
  PIECE
  KG
  GRAM
  LITER
  ML
  PACK
  BOX
  BOTTLE
  PORTION
  OTHER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
  REJECTED
  REFUNDED
}

enum OrderPaymentMethod {
  CASH
  WALLET
  CARD
  ONLINE
}

enum VehicleType {
  MOTORCYCLE
  CAR
  BICYCLE
  VAN
}

enum DriverStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED
}

enum DriverAvailabilityStatus {
  ONLINE
  OFFLINE
  BUSY
  ON_DELIVERY
}

enum DriverGender {
  MALE
  FEMALE
  OTHER
}

enum PaymentMethodType {
  CASH
  WALLET
  CREDIT_CARD
  DEBIT_CARD
  APPLE_PAY
  GOOGLE_PAY
  STRIPE
  PAYPAL
}

enum PaymentRecordStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentType {
  BOOKING
  ORDER
  TOP_UP
  OTHER
}

enum WalletStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  TOP_UP
  CASHBACK
  REWARD_CREDIT
  REWARD_REDEMPTION
  ADMIN_ADJUSTMENT
  PLATFORM_REFUND
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PointTransactionType {
  EARN
  REDEEM
  EXPIRE
  REFUND
  ADJUSTMENT
  BONUS
}

enum PointTransactionStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}

enum PointRuleType {
  PAYMENT
  BOOKING
  ORDER
  REFERRAL
  BIRTHDAY
  CAMPAIGN
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REPORTED
  DELETED
}

model QRCode {
  id              String    @id @default(uuid())
  qrId            String    @unique
  token           String    @unique
  bookingId       String    @unique
  bookingNumber   String
  customerId      String
  customerName    String
  businessId      String
  branchId        String
  serviceId       String
  bookingType     BookingType
  bookingDate     DateTime
  slotTime        String
  status          QRStatus  @default(GENERATED)
  generatedAt     DateTime  @default(now())
  expiryTime      DateTime
  scannedAt       DateTime?
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  scannedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer        User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service         Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  cashier         Cashier?  @relation(fields: [scannedBy], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([customerId])
  @@index([businessId])
  @@index([branchId])
  @@index([status])
  @@index([qrId])
  @@map("qr_codes")
}


// Syrian governorates with unique codes for Pass ID generation
model Governorate {
  id             String     @id @default(uuid())
  name           String     @unique
  nameAr         String?    @map("name_ar")
  code           String     @unique
  passIdSequence Int        @default(0) @map("pass_id_sequence")
  isActive       Boolean    @default(true) @map("is_active")
  users              User[]
  businesses         Business[]
  branches           Branch[]
  orderDeliveryAddresses OrderDeliveryAddress[]
  drivers            Driver[]
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@map("governorates")
}

// Application roles for RBAC - Enhanced
model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  displayName     String           @map("display_name")
  description     String?
  priority        Int              @default(10)
  isSystem        Boolean          @default(false) @map("is_system")
  status          RoleStatus       @default(ACTIVE)
  createdBy       String?          @map("created_by")
  updatedBy       String?          @map("updated_by")
  deletedAt       DateTime?        @map("deleted_at")
  users           User[]
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([name])
  @@index([status])
  @@index([priority])
  @@map("roles")
}

// Permissions for fine-grained access control
model Permission {
  id              String           @id @default(uuid())
  module          String
  name            String
  slug            String           @unique
  description     String?
  status          PermissionStatus @default(ACTIVE)
  deletedAt       DateTime?        @map("deleted_at")
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([module])
  @@index([slug])
  @@map("permissions")
}

// Pivot table for role-permission many-to-many relationship
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// Pivot table for user-role many-to-many relationship
model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@map("user_roles")
}

// Audit logs to track all admin operations
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  module    String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([module])
  @@index([action])
  @@map("audit_logs")
}

// Core user account shared across CoreSY Pass, Care, and Go
model User {
  id                 String           @id @default(uuid())
  passId             String           @unique @map("pass_id")
  fullName           String           @map("full_name")
  email              String           @unique
  phoneNumber        String           @unique @map("phone_number")
  smartAssistantName String?          @map("smart_assistant_name")
  profileImage       String?          @map("profile_image")
  password           String
  emailVerified      Boolean          @default(false) @map("email_verified")
  phoneVerified      Boolean          @default(false) @map("phone_verified")
  status             UserStatus       @default(PENDING_VERIFICATION)
  subscription       SubscriptionTier @default(FREE)
  acceptTerms        Boolean          @default(true) @map("accept_terms")
  governorateId      String           @map("governorate_id")
  governorate        Governorate      @relation(fields: [governorateId], references: [id])
  // Keep for compatibility, but use UserRole for actual roles
  roleId             String           @map("role_id")
  role               Role             @relation(fields: [roleId], references: [id])
  userRoles          UserRole[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  businesses         Business[]
  bookings           Booking[]
  qrCodes            QRCode[]
  orders             Order[]
  payments           Payment[]
  wallet             Wallet?
  pointAccount       PointAccount?
  reviews            Review[]            @relation("CustomerReviews")
  reviewLikes        ReviewLike[]
  reviewReports      ReviewReport[]
  reviewReplies      ReviewReply[]
  favoriteBusinesses FavoriteBusiness[]
  lastLogin          DateTime?        @map("last_login")
  createdBy          String?          @map("created_by")
  updatedBy          String?          @map("updated_by")
  deletedAt          DateTime?        @map("deleted_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([email])
  @@index([phoneNumber])
  @@index([status])
  @@map("users")
}

// Secure refresh token storage with rotation support
model RefreshToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  tokenHash String   @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// Notifications for admins
enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationDeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

model Notification {
  id               String                     @id @default(uuid())
  notificationId   String?                    @unique @map("notification_id")
  userId           String                     @map("user_id")
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId         String?                    @map("sender_id")
  title            String
  message          String
  type             String
  channel          NotificationChannel        @default(IN_APP)
  priority         NotificationPriority       @default(MEDIUM)
  module           String?
  referenceId      String?                    @map("reference_id")
  isRead           Boolean                    @default(false) @map("is_read")
  deliveryStatus   NotificationDeliveryStatus @default(DELIVERED) @map("delivery_status")
  failureReason    String?                    @map("failure_reason")
  retryCount       Int                        @default(0) @map("retry_count")
  data             Json?
  readAt           DateTime?                  @map("read_at")
  sentAt           DateTime?                  @map("sent_at")
  deliveredAt      DateTime?                  @map("delivered_at")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  @@index([userId])
  @@index([isRead])
  @@index([channel])
  @@index([priority])
  @@index([deliveryStatus])
  @@index([module])
  @@index([referenceId])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

// Business (Establishment) model
model Business {
  id                 String         @id @default(uuid())
  name               String         @map("name")
  type               BusinessType   @map("type")
  category           String         @map("category")
  description        String         @map("description")
  ownerName          String         @map("owner_name")
  ownerEmail         String         @map("owner_email")
  ownerPhone         String         @map("owner_phone")
  businessEmail      String         @unique @map("business_email")
  businessPhone      String         @map("business_phone")
  logo               String?        @map("logo")
  coverImage         String?        @map("cover_image")
  registrationNumber String         @unique @map("registration_number")
  taxNumber          String?        @map("tax_number")
  website            String?        @map("website")
  governorateId      String         @map("governorate_id")
  governorate        Governorate    @relation(fields: [governorateId], references: [id])
  city               String         @map("city")
  address            String         @map("address")
  latitude           Decimal?       @map("latitude")
  longitude          Decimal?       @map("longitude")
  workingHours       Json?          @map("working_hours")
  facebook           String?        @map("facebook")
  instagram          String?        @map("instagram")
  whatsApp           String?        @map("whats_app")
  status             BusinessStatus @default(PENDING) @map("status")
  approvalDate       DateTime?      @map("approval_date")
  approvedBy         String?        @map("approved_by")
  ownerId            String         @map("owner_id")
  owner              User           @relation(fields: [ownerId], references: [id])
  branches           Branch[]
  services           Service[]
  cashiers           Cashier[]
  slots              Slot[]
  bookings           Booking[]
  qrCodes            QRCode[]
  favoriteBusinesses FavoriteBusiness[]
  productCategories  ProductCategory[]
  products           Product[]
  businessOrders     BusinessOrder[]
  orderItems         OrderItem[]
  payments           Payment[]
  reviews            Review[]
  createdBy          String?        @map("created_by")
  updatedBy          String?        @map("updated_by")
  deletedAt          DateTime?      @map("deleted_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([name])
  @@index([status])
  @@index([type])
  @@index([ownerId])
  @@map("businesses")
}

// Business Branch model
model Branch {
  id               String       @id @default(uuid())
  name             String       @map("name")
  code             String       @unique @map("code")
  businessId       String       @map("business_id")
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type             String       @map("type")
  description      String?      @map("description")
  governorateId    String       @map("governorate_id")
  governorate      Governorate  @relation(fields: [governorateId], references: [id])
  city             String       @map("city")
  address          String       @map("address")
  latitude         Decimal?     @map("latitude")
  longitude        Decimal?     @map("longitude")
  googleMapLink    String?      @map("google_map_link")
  contactEmail     String?      @map("contact_email")
  contactPhone     String?      @map("contact_phone")
  whatsAppNumber   String?      @map("whats_app_number")
  workingDays      Json?        @map("working_days")
  openingTime      String?      @map("opening_time")
  closingTime      String?      @map("closing_time")
  emergencyContact String?      @map("emergency_contact")
  image            String?      @map("image")
  coverImage       String?      @map("cover_image")
  status           BranchStatus @default(PENDING) @map("status")
  isMain           Boolean      @default(false) @map("is_main")
  services         Service[]
  cashiers         Cashier[]
  slots            Slot[]
  bookings         Booking[]
  qrCodes          QRCode[]
  products         Product[]
  businessOrders   BusinessOrder[]
  orderItems       OrderItem[]
  payments         Payment[]
  reviews          Review[]
  createdBy        String?      @map("created_by")
  updatedBy        String?      @map("updated_by")
  deletedAt        DateTime?    @map("deleted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([name])
  @@index([code])
  @@index([businessId])
  @@index([status])
  @@index([governorateId])
  @@map("branches")
}

// Business Service model
model Service {
  id                  String         @id @default(uuid())
  name                String       @map("name")
  code                String       @unique @map("code")
  businessId          String       @map("business_id")
  business            Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId            String       @map("branch_id")
  branch              Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category            ServiceCategory @map("category")
  type                ServiceType   @map("type")
  description         String       @map("description")
  shortDescription    String?      @map("short_description")
  price               Decimal      @db.Decimal(10, 2) @map("price")
  discountPercentage   Decimal?     @db.Decimal(5, 2) @map("discount_percentage")
  coresyDiscount      Decimal?     @db.Decimal(5, 2) @map("coresy_discount")
  platformFee         Decimal?     @db.Decimal(5, 2) @map("platform_fee")
  duration            Int?         @map("duration") // In minutes
  maxCapacity         Int?         @map("max_capacity")
  bookingRequired     Boolean      @default(false) @map("booking_required")
  appointmentRequired Boolean      @default(false) @map("appointment_required")
  deliveryAvailable    Boolean      @default(false) @map("delivery_available")
  isFeatured          Boolean      @default(false) @map("is_featured")
  serviceImage         String?      @map("service_image")
  galleryImages       String[]     @map("gallery_images")
  status              ServiceStatus @default(DRAFT) @map("status")
  createdBy           String?      @map("created_by")
  updatedBy           String?      @map("updated_by")
  deletedAt           DateTime?    @map("deleted_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@index([name])
  @@index([code])
  @@index([businessId])
  @@index([branchId])
  @@index([status])
  @@index([category])
  @@index([type])
  @@index([isFeatured])
  slots            Slot[]
  bookings         Booking[]
  qrCodes          QRCode[]
  reviews          Review[]
  @@map("services")
}

// Slot model
model Slot {
  id                 String          @id @default(uuid())
  serviceId          String          @map("service_id")
  service            Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  businessId         String          @map("business_id")
  business           Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId           String          @map("branch_id")
  branch             Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  slotDate           DateTime        @map("slot_date")
  dayOfWeek          Int             @map("day_of_week") // 0 = Sunday, 6 = Saturday
  startTime          String          @map("start_time") // "HH:MM"
  endTime            String          @map("end_time") // "HH:MM"
  duration           Int             @map("duration") // in minutes
  maxCapacity        Int             @map("max_capacity")
  remainingCapacity  Int             @map("remaining_capacity")
  bookingType        BookingType     @map("booking_type")
  genderRestriction  GenderRestriction? @map("gender_restriction")
  minAge             Int?            @map("min_age")
  maxAge             Int?            @map("max_age")
  isRecurring        Boolean         @default(false) @map("is_recurring")
  recurringType      RecurringType   @default(NONE) @map("recurring_type")
  recurringEndDate   DateTime?       @map("recurring_end_date")
  status             SlotStatus      @default(AVAILABLE) @map("status")
  createdBy          String?         @map("created_by")
  updatedBy          String?         @map("updated_by")
  deletedAt          DateTime?       @map("deleted_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([serviceId])
  @@index([businessId])
  @@index([branchId])
  @@index([slotDate])
  @@index([status])
  @@index([bookingType])
  bookings           Booking[]
  @@map("slots")
}
model Cashier {
  id               String       @id @default(uuid())
  fullName         String       @map("full_name")
  employeeId       String       @unique @map("employee_id")
  email            String       @unique
  phoneNumber      String       @unique @map("phone_number")
  password         String
  businessId       String       @map("business_id")
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId         String       @map("branch_id")
  branch           Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  profileImage     String?      @map("profile_image")
  status           CashierStatus @default(PENDING) @map("status")
  joiningDate      DateTime?    @map("joining_date")
  lastLogin        DateTime?    @map("last_login")
  createdBy        String?      @map("created_by")
  updatedBy        String?      @map("updated_by")
  deletedAt        DateTime?    @map("deleted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  scannedQrCodes   QRCode[]

  @@index([fullName])
  @@index([employeeId])
  @@index([email])
  @@index([phoneNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([status])
  @@map("cashiers")
}

// Booking model
model Booking {
  id                 String         @id @default(uuid())
  bookingNumber      String         @unique @map("booking_number")
  customerId         String         @map("customer_id")
  customer           User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId         String         @map("business_id")
  business           Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId           String         @map("branch_id")
  branch             Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  serviceId          String         @map("service_id")
  service            Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  slotId             String         @map("slot_id")
  slot               Slot           @relation(fields: [slotId], references: [id], onDelete: Cascade)
  bookingType        BookingType    @map("booking_type")
  reservationDate    DateTime       @map("reservation_date")
  startTime          String         @map("start_time")
  endTime            String         @map("end_time")
  numberOfGuests     Int            @map("number_of_guests")
  specialInstructions String?       @map("special_instructions")
  bookingSource      BookingSource  @default(MOBILE_APP) @map("booking_source")
  paymentMethod      String?        @map("payment_method")
  paymentStatus      PaymentStatus  @default(PENDING) @map("payment_status")
  status             BookingStatus  @default(PENDING)
  qrCode             String?        @map("qr_code")
  checkInTime        DateTime?      @map("check_in_time")
  checkOutTime       DateTime?      @map("check_out_time")
  cancellationReason String?        @map("cancellation_reason")
  createdBy          String?        @map("created_by")
  updatedBy          String?        @map("updated_by")
  deletedAt          DateTime?      @map("deleted_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  qrCodeRecord       QRCode?
  payments           Payment[]
  reviews            Review[]

  @@index([bookingNumber])
  @@index([customerId])
  @@index([businessId])
  @@index([branchId])
  @@index([serviceId])
  @@index([slotId])
  @@index([status])
  @@index([paymentStatus])
  @@index([reservationDate])
  @@index([bookingType])
  @@map("bookings")
}

// Favorite Business model
model FavoriteBusiness {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@map("favorite_businesses")
}

// Product category (main and sub categories for CoreSY Go)
model ProductCategory {
  id           String            @id @default(uuid())
  name         String            @map("name")
  nameAr       String?           @map("name_ar")
  slug         String            @map("slug")
  description  String?           @map("description")
  image        String?           @map("image")
  sortOrder    Int               @default(0) @map("sort_order")
  isActive     Boolean           @default(true) @map("is_active")
  businessId   String?           @map("business_id")
  business     Business?         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parentId     String?           @map("parent_id")
  parent       ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     ProductCategory[] @relation("CategoryHierarchy")
  products     Product[]         @relation("ProductMainCategory")
  subProducts  Product[]         @relation("ProductSubCategory")
  createdBy    String?           @map("created_by")
  updatedBy    String?           @map("updated_by")
  deletedAt    DateTime?         @map("deleted_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([businessId, slug])
  @@index([name])
  @@index([slug])
  @@index([businessId])
  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("product_categories")
}

// CoreSY Go product catalog
model Product {
  id                 String         @id @default(uuid())
  name               String         @map("name")
  sku                String         @map("sku")
  code               String         @unique @map("code")
  description        String?        @map("description")
  businessId         String         @map("business_id")
  business           Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId           String         @map("branch_id")
  branch             Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categoryId         String         @map("category_id")
  category           ProductCategory @relation("ProductMainCategory", fields: [categoryId], references: [id])
  subCategoryId      String?        @map("sub_category_id")
  subCategory        ProductCategory? @relation("ProductSubCategory", fields: [subCategoryId], references: [id])
  images             String[]       @map("images")
  basePrice          Decimal        @db.Decimal(10, 2) @map("base_price")
  discountPrice      Decimal?       @db.Decimal(10, 2) @map("discount_price")
  subscriberPrice    Decimal?       @db.Decimal(10, 2) @map("subscriber_price")
  stockQuantity      Int            @default(0) @map("stock_quantity")
  unlimitedStock     Boolean        @default(false) @map("unlimited_stock")
  lowStockThreshold  Int            @default(10) @map("low_stock_threshold")
  preparationTime    Int?           @map("preparation_time")
  unit               ProductUnit    @default(PIECE) @map("unit")
  weight             Decimal?       @db.Decimal(10, 3) @map("weight")
  tags               String[]       @map("tags")
  barcode            String?        @map("barcode")
  status             ProductStatus  @default(ACTIVE) @map("status")
  isFeatured         Boolean        @default(false) @map("is_featured")
  isRecommended      Boolean        @default(false) @map("is_recommended")
  variants           ProductVariant[]
  inventoryLogs      ProductInventoryLog[]
  orderItems         OrderItem[]
  reviews            Review[]
  createdBy          String?        @map("created_by")
  updatedBy          String?        @map("updated_by")
  deletedAt          DateTime?      @map("deleted_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@unique([businessId, sku])
  @@index([name])
  @@index([sku])
  @@index([code])
  @@index([businessId])
  @@index([branchId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([status])
  @@index([barcode])
  @@index([isFeatured])
  @@index([isRecommended])
  @@index([basePrice])
  @@map("products")
}

// Optional product variants for future cart/order modules
model ProductVariant {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String   @map("name")
  sku            String?  @map("sku")
  price          Decimal? @db.Decimal(10, 2) @map("price")
  stockQuantity  Int      @default(0) @map("stock_quantity")
  attributes     Json?    @map("attributes")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

// Inventory movement log for stock audit trail
model ProductInventoryLog {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  previousStock Int      @map("previous_stock")
  newStock      Int      @map("new_stock")
  changeAmount  Int      @map("change_amount")
  reason        String?  @map("reason")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([createdAt])
  @@map("product_inventory_logs")
}

// Master multi-vendor order for CoreSY Go
model Order {
  id                    String              @id @default(uuid())
  orderNumber           String              @unique @map("order_number")
  customerId            String              @map("customer_id")
  customer              User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentMethod         OrderPaymentMethod  @default(CASH) @map("payment_method")
  paymentStatus         PaymentStatus       @default(PENDING) @map("payment_status")
  status                OrderStatus         @default(PENDING)
  totalAmount           Decimal             @db.Decimal(12, 2) @map("total_amount")
  discount              Decimal             @default(0) @db.Decimal(12, 2)
  subscriberDiscount    Decimal             @default(0) @db.Decimal(12, 2) @map("subscriber_discount")
  platformFee           Decimal             @default(0) @db.Decimal(12, 2) @map("platform_fee")
  deliveryFee           Decimal             @default(0) @db.Decimal(12, 2) @map("delivery_fee")
  tax                   Decimal             @default(0) @db.Decimal(12, 2)
  grandTotal            Decimal             @db.Decimal(12, 2) @map("grand_total")
  estimatedDeliveryTime DateTime?           @map("estimated_delivery_time")
  deliveryNotes         String?             @map("delivery_notes")
  cancellationReason    String?             @map("cancellation_reason")
  invoiceNumber         String?             @unique @map("invoice_number")
  invoiceData           Json?               @map("invoice_data")
  deliveryAddress       OrderDeliveryAddress?
  businessOrders        BusinessOrder[]
  items                 OrderItem[]
  payments              Payment[]
  reviews               Review[]
  createdBy             String?             @map("created_by")
  updatedBy             String?             @map("updated_by")
  deletedAt             DateTime?           @map("deleted_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

// Per-business sub-order split from master order
model BusinessOrder {
  id                 String      @id @default(uuid())
  businessOrderNumber String     @unique @map("business_order_number")
  orderId            String      @map("order_id")
  order              Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  businessId         String      @map("business_id")
  business           Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId           String      @map("branch_id")
  branch             Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  status             OrderStatus @default(PENDING)
  subtotal           Decimal     @db.Decimal(12, 2)
  discount           Decimal     @default(0) @db.Decimal(12, 2)
  total              Decimal     @db.Decimal(12, 2)
  rejectionReason    String?     @map("rejection_reason")
  acceptedAt         DateTime?   @map("accepted_at")
  preparingAt        DateTime?   @map("preparing_at")
  readyAt            DateTime?   @map("ready_at")
  deliveredAt        DateTime?   @map("delivered_at")
  cancelledAt        DateTime?   @map("cancelled_at")
  items              OrderItem[]
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([businessId])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@map("business_orders")
}

// Order line items with product snapshots
model OrderItem {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  businessOrderId String        @map("business_order_id")
  businessOrder   BusinessOrder @relation(fields: [businessOrderId], references: [id], onDelete: Cascade)
  productId       String        @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])
  businessId      String        @map("business_id")
  business        Business      @relation(fields: [businessId], references: [id])
  branchId        String        @map("branch_id")
  branch          Branch        @relation(fields: [branchId], references: [id])
  productName     String        @map("product_name")
  productSku      String        @map("product_sku")
  productCode     String?       @map("product_code")
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2) @map("unit_price")
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  subtotal        Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([orderId])
  @@index([businessOrderId])
  @@index([productId])
  @@index([businessId])
  @@index([branchId])
  @@map("order_items")
}

// Delivery address snapshot for an order
model OrderDeliveryAddress {
  id            String      @id @default(uuid())
  orderId       String      @unique @map("order_id")
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerName  String      @map("customer_name")
  phone         String
  governorateId String      @map("governorate_id")
  governorate   Governorate @relation(fields: [governorateId], references: [id])
  area          String
  street        String
  building      String?
  floor         String?
  apartment     String?
  latitude      Decimal?    @db.Decimal(10, 7)
  longitude     Decimal?    @db.Decimal(10, 7)
  deliveryNotes String?     @map("delivery_notes")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([governorateId])
  @@map("order_delivery_addresses")
}

// CoreSY Go driver profile and vehicle information
model Driver {
  id                        String                   @id @default(uuid())
  driverId                  String                   @unique @map("driver_id")
  fullName                  String                   @map("full_name")
  email                     String                   @unique
  phoneNumber               String                   @unique @map("phone_number")
  password                  String
  profilePhoto              String?                  @map("profile_photo")
  dateOfBirth               DateTime?                @map("date_of_birth")
  gender                    DriverGender?
  nationalId                String                   @unique @map("national_id")
  drivingLicense            String                   @unique @map("driving_license")
  nationalIdDocument        String?                  @map("national_id_document")
  drivingLicenseDocument    String?                  @map("driving_license_document")
  insuranceDocument         String?                  @map("insurance_document")
  vehicleType               VehicleType              @map("vehicle_type")
  vehicleBrand              String?                  @map("vehicle_brand")
  vehicleModel              String?                  @map("vehicle_model")
  vehicleRegistrationNumber String                   @unique @map("vehicle_registration_number")
  vehiclePlateNumber        String                   @unique @map("vehicle_plate_number")
  vehicleImages             String[]                 @map("vehicle_images")
  status                    DriverStatus             @default(PENDING_VERIFICATION)
  availabilityStatus        DriverAvailabilityStatus @default(OFFLINE) @map("availability_status")
  isOnline                  Boolean                  @default(false) @map("is_online")
  rating                    Decimal                  @default(0) @db.Decimal(3, 2)
  totalDeliveries           Int                      @default(0) @map("total_deliveries")
  completedDeliveries       Int                      @default(0) @map("completed_deliveries")
  cancelledDeliveries       Int                      @default(0) @map("cancelled_deliveries")
  currentLatitude           Decimal?                 @db.Decimal(10, 7) @map("current_latitude")
  currentLongitude          Decimal?                 @db.Decimal(10, 7) @map("current_longitude")
  locationUpdatedAt         DateTime?                @map("location_updated_at")
  governorateId             String                   @map("governorate_id")
  governorate               Governorate              @relation(fields: [governorateId], references: [id])
  rejectionReason           String?                  @map("rejection_reason")
  approvedAt                DateTime?                @map("approved_at")
  approvedBy                String?                  @map("approved_by")
  lastLogin                 DateTime?                @map("last_login")
  createdBy                 String?                  @map("created_by")
  updatedBy                 String?                  @map("updated_by")
  deletedAt                 DateTime?                @map("deleted_at")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")

  reviews                   Review[]
  @@index([driverId])
  @@index([email])
  @@index([phoneNumber])
  @@index([status])
  @@index([availabilityStatus])
  @@index([vehicleType])
  @@index([governorateId])
  @@index([rating])
  @@index([isOnline])
  @@map("drivers")
}

// Payment records across CoreSY Pass, Care, and Go
model Payment {
  id                 String              @id @default(uuid())
  paymentId          String              @unique @map("payment_id")
  transactionNumber  String              @unique @map("transaction_number")
  bookingId          String?             @map("booking_id")
  booking            Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  orderId            String?             @map("order_id")
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId         String              @map("customer_id")
  customer           User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId         String?             @map("business_id")
  business           Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)
  branchId           String?             @map("branch_id")
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  paymentMethod      PaymentMethodType   @map("payment_method")
  paymentType        PaymentType         @default(OTHER) @map("payment_type")
  subtotal           Decimal             @db.Decimal(12, 2)
  discount           Decimal             @default(0) @db.Decimal(12, 2)
  subscriberDiscount Decimal             @default(0) @db.Decimal(12, 2) @map("subscriber_discount")
  platformFee        Decimal             @default(0) @db.Decimal(12, 2) @map("platform_fee")
  deliveryFee        Decimal             @default(0) @db.Decimal(12, 2) @map("delivery_fee")
  tax                Decimal             @default(0) @db.Decimal(12, 2)
  grandTotal         Decimal             @db.Decimal(12, 2) @map("grand_total")
  refundedAmount     Decimal             @default(0) @db.Decimal(12, 2) @map("refunded_amount")
  currency           String              @default("SYP")
  status             PaymentRecordStatus @default(PENDING)
  gatewayReference   String?             @map("gateway_reference")
  invoiceNumber      String?             @unique @map("invoice_number")
  invoiceData        Json?               @map("invoice_data")
  receiptData        Json?               @map("receipt_data")
  failureReason      String?             @map("failure_reason")
  cancellationReason String?             @map("cancellation_reason")
  refundReason       String?             @map("refund_reason")
  transactionDate    DateTime            @default(now()) @map("transaction_date")
  completedAt        DateTime?           @map("completed_at")
  walletTransactions WalletTransaction[]
  createdBy          String?             @map("created_by")
  updatedBy          String?             @map("updated_by")
  deletedAt          DateTime?           @map("deleted_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([paymentId])
  @@index([transactionNumber])
  @@index([bookingId])
  @@index([orderId])
  @@index([customerId])
  @@index([businessId])
  @@index([branchId])
  @@index([status])
  @@index([paymentMethod])
  @@index([paymentType])
  @@index([transactionDate])
  @@map("payments")
}

// Customer wallet
model Wallet {
  id               String              @id @default(uuid())
  walletId         String              @unique @map("wallet_id")
  customerId       String              @unique @map("customer_id")
  customer         User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currentBalance   Decimal             @default(0) @db.Decimal(12, 2) @map("current_balance")
  availableBalance Decimal             @default(0) @db.Decimal(12, 2) @map("available_balance")
  blockedBalance   Decimal             @default(0) @db.Decimal(12, 2) @map("blocked_balance")
  currency         String              @default("SYP")
  status           WalletStatus        @default(ACTIVE)
  transactions     WalletTransaction[]
  createdBy        String?             @map("created_by")
  updatedBy        String?             @map("updated_by")
  deletedAt        DateTime?           @map("deleted_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([walletId])
  @@index([customerId])
  @@index([status])
  @@map("wallets")
}

// Wallet ledger transactions
model WalletTransaction {
  id              String                  @id @default(uuid())
  transactionId   String                  @unique @map("transaction_id")
  walletId        String                  @map("wallet_id")
  wallet          Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  referenceNumber String                  @unique @map("reference_number")
  bookingId       String?                 @map("booking_id")
  orderId         String?                 @map("order_id")
  paymentId       String?                 @map("payment_id")
  payment         Payment?                @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  type            WalletTransactionType
  amount          Decimal                 @db.Decimal(12, 2)
  balanceBefore   Decimal                 @db.Decimal(12, 2) @map("balance_before")
  balanceAfter    Decimal                 @db.Decimal(12, 2) @map("balance_after")
  description     String?
  status          WalletTransactionStatus @default(COMPLETED)
  createdBy       String?                 @map("created_by")
  createdAt       DateTime                @default(now()) @map("created_at")

  @@index([walletId])
  @@index([referenceNumber])
  @@index([bookingId])
  @@index([orderId])
  @@index([paymentId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// Customer loyalty point account
model PointAccount {
  id              String             @id @default(uuid())
  pointWalletId   String             @unique @map("point_wallet_id")
  customerId      String             @unique @map("customer_id")
  customer        User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  availablePoints Int                @default(0) @map("available_points")
  redeemedPoints  Int                @default(0) @map("redeemed_points")
  expiredPoints   Int                @default(0) @map("expired_points")
  lifetimePoints  Int                @default(0) @map("lifetime_points")
  currentTier     LoyaltyTier        @default(BRONZE) @map("current_tier")
  transactions    PointTransaction[]
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([pointWalletId])
  @@index([customerId])
  @@index([currentTier])
  @@map("point_accounts")
}

// Point ledger transactions
model PointTransaction {
  id              String                 @id @default(uuid())
  referenceNumber String                 @unique @map("reference_number")
  pointAccountId  String                 @map("point_account_id")
  pointAccount    PointAccount           @relation(fields: [pointAccountId], references: [id], onDelete: Cascade)
  customerId      String                 @map("customer_id")
  type            PointTransactionType
  points          Int
  balanceBefore   Int                    @map("balance_before")
  balanceAfter    Int                    @map("balance_after")
  status          PointTransactionStatus @default(COMPLETED)
  bookingId       String?                @map("booking_id")
  orderId         String?                @map("order_id")
  paymentId       String?                @map("payment_id")
  description     String?
  expiresAt       DateTime?              @map("expires_at")
  createdBy       String?                @map("created_by")
  createdAt       DateTime               @default(now()) @map("created_at")

  @@index([pointAccountId])
  @@index([customerId])
  @@index([referenceNumber])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("point_transactions")
}

// Configurable point earning/redemption rules
model PointRule {
  id          String        @id @default(uuid())
  name        String
  type        PointRuleType
  points      Int
  minAmount   Decimal?      @db.Decimal(12, 2) @map("min_amount")
  isActive    Boolean       @default(true) @map("is_active")
  description String?
  createdBy   String?       @map("created_by")
  updatedBy   String?       @map("updated_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([type])
  @@index([isActive])
  @@map("point_rules")
}

// Customer ratings and reviews
model Review {
  id                  String        @id @default(uuid())
  reviewId            String        @unique @map("review_id")
  customerId          String        @map("customer_id")
  customer            User          @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  businessId          String?       @map("business_id")
  business            Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  branchId            String?       @map("branch_id")
  branch              Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  serviceId           String?       @map("service_id")
  service             Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  productId           String?       @map("product_id")
  product             Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  driverId            String?       @map("driver_id")
  driver              Driver?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  bookingId           String?       @unique @map("booking_id")
  booking             Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  orderId             String?       @unique @map("order_id")
  order               Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  overallRating       Int           @map("overall_rating")
  serviceRating       Int?          @map("service_rating")
  qualityRating       Int?          @map("quality_rating")
  cleanlinessRating   Int?          @map("cleanliness_rating")
  deliveryRating      Int?          @map("delivery_rating")
  communicationRating Int?          @map("communication_rating")
  title               String?
  description         String?
  images              String[]
  status              ReviewStatus  @default(PUBLISHED)
  likesCount          Int           @default(0) @map("likes_count")
  likes               ReviewLike[]
  reports             ReviewReport[]
  reply               ReviewReply?
  createdBy           String?       @map("created_by")
  updatedBy           String?       @map("updated_by")
  deletedAt           DateTime?     @map("deleted_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@index([reviewId])
  @@index([customerId])
  @@index([businessId])
  @@index([branchId])
  @@index([serviceId])
  @@index([productId])
  @@index([driverId])
  @@index([status])
  @@index([overallRating])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewLike {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([reviewId, userId])
  @@map("review_likes")
}

model ReviewReport {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([reviewId, userId])
  @@map("review_reports")
}

model ReviewReply {
  id         String   @id @default(uuid())
  reviewId   String   @unique @map("review_id")
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  businessId String?  @map("business_id")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("review_replies")
}
